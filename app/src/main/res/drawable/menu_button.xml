<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#55344248"/><corners android:radius="6dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#DA216B79"/><corners android:radius="6dp"/></shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#D52C6470"/>
            <stroke android:width="2dp" android:color="#FFFFFF"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#923D4B52"/>
            <stroke android:width="1dp" android:color="#558D9EA5"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
</selector>
